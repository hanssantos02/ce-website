# Supabase Dashboard > Connect > App Frameworks, or Project Settings > API Keys.
# Use the publishable key only. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Canonical origin for email callbacks; replace with the exact HTTPS origin before deployment.
APP_SITE_URL=http://localhost:3000
